# Copy to .env and fill in. Never commit .env.

# Postgres
POSTGRES_USER=datasenter
POSTGRES_PASSWORD=changeme
POSTGRES_DB=datasenter
POSTGRES_HOST=db
POSTGRES_PORT=5432

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5174

# Web (Vite — must be prefixed VITE_)
VITE_API_BASE_URL=http://localhost:8001

# Anthropic (only needed for M3 pipeline, not for API/web)
ANTHROPIC_API_KEY=

# Optional — Sentry / observability
SENTRY_DSN=
