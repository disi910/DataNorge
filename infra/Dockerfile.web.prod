# Production web image: static Vite build served by nginx.
#
#   docker build -f infra/Dockerfile.web.prod \
#     --build-arg VITE_BASE_PATH=/datanorge/ \
#     --build-arg VITE_API_BASE_URL=/datanorge/api .

FROM node:20-alpine AS build

WORKDIR /app

COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

COPY apps/web .

# Public URL prefix the app is served under, and where the browser finds the API.
ARG VITE_BASE_PATH=/
ARG VITE_API_BASE_URL=/api
ENV VITE_BASE_PATH=$VITE_BASE_PATH \
    VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

FROM nginx:alpine
COPY infra/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
